{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lumen-photo-api",
  "main": "worker.ts",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://xiaoxiaoxiaoxiaoxiaojun.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumen-photo-db",
      "database_id": "b5afc2bd-827e-44ef-b981-c2ea634977bb",
      "migrations_dir": "migrations"
    }
  ]
}
